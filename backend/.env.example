# "sqlite" (local file, default) or "d1" (Cloudflare D1)
DB_BACKEND=sqlite
SQLITE_PATH=data/wind.db

# Cloudflare D1, only needed when DB_BACKEND=d1
CLOUDFLARE_ACCOUNT_ID=
D1_DATABASE_ID=
# "token": use CLOUDFLARE_API_TOKEN (needs "D1: Edit"); required when deployed
# "wrangler": borrow the local Wrangler login, renewed automatically (development only)
D1_AUTH=token
CLOUDFLARE_API_TOKEN=
